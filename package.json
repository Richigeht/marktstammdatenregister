{
  "name": "mastr-bess-atlas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --root site --host 0.0.0.0",
    "build": "astro build --root site",
    "test": "node --test tests/frontend/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write site/src site/astro.config.mjs tests/frontend tests/browser playwright.config.js",
    "format:check": "prettier --check site/src site/astro.config.mjs tests/frontend tests/browser playwright.config.js"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.4.13",
    "echarts": "6.1.0",
    "leaflet": "1.9.4",
    "supercluster": "9.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2"
  }
}
